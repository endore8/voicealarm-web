---
import { Download, Mic, AlarmClock, ArrowRight } from "@lucide/astro";
import IPhoneFrame from "./IPhoneFrame.astro";
import Logo from "../assets/logo.svg";

const APP_STORE_URL = "https://apps.apple.com/app/apple-store/id6820056647";

const bullets = [
    { icon: Download, text: "Get the app", href: APP_STORE_URL },
    { icon: Mic, text: "Record voice" },
    { icon: AlarmClock, text: "Set the alarm" },
];
---

<section class="relative z-10 flex grow items-center px-6 py-20">
    <div
        class="mx-auto grid w-full max-w-4xl items-center gap-16 lg:grid-cols-[1fr_auto] lg:gap-20"
    >
        <div class="mx-auto w-full max-w-sm lg:mx-0 lg:max-w-none">
            <h1>
                <Logo class="h-14 w-auto sm:h-16 lg:h-20" aria-hidden="true" />
                <span class="sr-only">Alarma</span>
            </h1>
            <p
                class="mt-6 text-2xl text-balance text-stone-700 sm:text-3xl"
            >
                Wake up to the voice you love
            </p>

            <ul class="mt-12 space-y-6">
                {
                    bullets.map(({ icon: Icon, text, href }) => {
                        const Tag = href ? "a" : "span";
                        return (
                            <li>
                                <Tag
                                    href={href}
                                    class:list={[
                                        "group flex items-center gap-4",
                                        href && "w-fit",
                                    ]}
                                >
                                    <span class:list={[
                                        "flex size-12 shrink-0 items-center justify-center rounded-2xl bg-stone-900/10 text-stone-900",
                                        href && "transition group-hover:bg-stone-900 group-hover:text-white",
                                    ]}>
                                        <Icon size={24} stroke-width={2} />
                                    </span>
                                    <span class:list={[
                                        "text-xl font-medium text-balance text-stone-800 sm:text-2xl",
                                        href && "underline decoration-stone-900/25 underline-offset-4 transition group-hover:decoration-stone-900",
                                    ]}>
                                        {text}
                                    </span>
                                </Tag>
                            </li>
                        );
                    })
                }
            </ul>

            <p
                class="mt-12 text-sm font-medium tracking-[0.18em] text-stone-900/60 uppercase"
            >
                For Creators
            </p>
            <a
                href="/creators"
                class="group mt-0.5 inline-flex items-center gap-2 text-base text-stone-600 transition hover:text-stone-900"
            >
                Earn 50% of profit with our affiliate program
                <ArrowRight
                    size={18}
                    stroke-width={2}
                    class="transition group-hover:translate-x-0.5"
                />
            </a>
        </div>

        <IPhoneFrame class="mx-auto w-72 sm:w-80">
            <img
                src="/screenshot.png"
                alt="Alarma's alarm list, with alarms set to wake up to Julia's and Lizzy's voices"
                width="786"
                height="1709"
                class="size-full object-cover object-top"
                loading="eager"
            />
        </IPhoneFrame>
    </div>
</section>
